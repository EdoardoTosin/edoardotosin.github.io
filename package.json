{
  "name": "edoardotosin.github.io",
  "version": "1.0.0",
  "description": "Jekyll theme for a personal blog and portfolio.",
  "private": true,
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdoardoTosin/edoardotosin.github.io.git"
  },
  "homepage": "https://github.com/EdoardoTosin/edoardotosin.github.io#readme",
  "bugs": {
    "url": "https://github.com/EdoardoTosin/edoardotosin.github.io/issues"
  },
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "jest",
    "test:node": "jest",
    "test:ruby": "bundle exec rake test",
    "vendor": "node scripts/sync-vendor-assets.js",
    "minify": "node scripts/minify-assets.js",
    "audit": "node scripts/audit.js",
    "audit:deps": "npm audit --audit-level=high",
    "check": "npm run format:check && npm run test:node",
    "ci": "npm run check && npm run audit:deps",
    "all": "npm run ci",
    "serve:dev": "bundle exec jekyll serve --config _config.yml,_config.dev.yml --livereload",
    "build": "bundle exec jekyll build",
    "build:min": "npm run build && npm run minify",
    "ci:linux": "npm run ci && npm run test:ruby && npm run build:min && npm run audit"
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "^1.10.3",
    "axe-core": "^4.12.1",
    "esbuild": "^0.28.2",
    "jest": "^30.4.2",
    "js-yaml": "^5.2.3",
    "jsdom": "^29.1.1",
    "mathjax": "^4.1.3",
    "mermaid": "^12.2.0"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/_site/"
    ]
  },
  "overrides": {
    "deepmerge": "4.1.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    },
    "jest": {
      "glob": "^14.0.3"
    },
    "babel-plugin-istanbul": {
      "test-exclude": {
        "glob": "^14.0.3",
        "minimatch": "^11.0.3"
      }
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "main": "sw.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": []
}
